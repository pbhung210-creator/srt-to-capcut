<Window x:Class="SrtCapcut.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SRT TO CAPCUT AUTO TIMELINE" Height="780" Width="1100"
        MinHeight="640" MinWidth="900"
        Background="#181818" Foreground="#F0F0F0"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#242424"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#CFCFCF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Width" Value="120"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CFCFCF"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="SRT TO CAPCUT AUTO TIMELINE" FontSize="22" FontWeight="Bold"
                   Foreground="#FFD166" Margin="4,0,4,10"/>

        <GroupBox Grid.Row="1" Header="1. Chọn dữ liệu đầu vào" Foreground="#FFD166" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="File SRT:"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtSrt"/>
                <Button Grid.Row="0" Grid.Column="2" x:Name="btnSrt" Content="Chọn file SRT..." Click="BtnSrt_Click"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Thư mục ảnh:"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtImages"/>
                <Button Grid.Row="1" Grid.Column="2" x:Name="btnImages" Content="Chọn thư mục ảnh..." Click="BtnImages_Click"/>

                <Label Grid.Row="2" Grid.Column="0" Content="Dự án CapCut mẫu:"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtTemplate"/>
                <Button Grid.Row="2" Grid.Column="2" x:Name="btnTemplate" Content="Chọn dự án mẫu..." Click="BtnTemplate_Click"/>

                <Label Grid.Row="3" Grid.Column="0" Content="Thư mục xuất:"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtOutput"/>
                <Button Grid.Row="3" Grid.Column="2" x:Name="btnOutput" Content="Chọn thư mục xuất..." Click="BtnOutput_Click"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="2. Tùy chọn và chức năng" Foreground="#FFD166" Margin="0,0,0,8">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <Label Content="Tỉ lệ khung hình:"/>
                    <ComboBox x:Name="cboAspect" SelectedIndex="0">
                        <ComboBoxItem Content="16:9"/>
                        <ComboBoxItem Content="9:16"/>
                    </ComboBox>
                    <Label Content="FPS:" Margin="16,0,0,0"/>
                    <ComboBox x:Name="cboFps" SelectedIndex="2">
                        <ComboBoxItem Content="24"/>
                        <ComboBoxItem Content="25"/>
                        <ComboBoxItem Content="30"/>
                        <ComboBoxItem Content="60"/>
                    </ComboBox>
                    <CheckBox x:Name="chkCopyAssets" Content="Sao chép ảnh vào thư mục Assets của dự án" IsChecked="True"/>
                </WrapPanel>
                <WrapPanel Margin="0,6,0,0">
                    <Button x:Name="btnCheck" Content="KIỂM TRA SRT VÀ ẢNH" Click="BtnCheck_Click"
                            Background="#1F6FEB" FontWeight="Bold"/>
                    <Button x:Name="btnGenerate" Content="TẠO DỰ ÁN CAPCUT" Click="BtnGenerate_Click"
                            Background="#1A7F37" FontWeight="Bold" IsEnabled="False"/>
                    <Button x:Name="btnOpenFolder" Content="MỞ THƯ MỤC KẾT QUẢ" Click="BtnOpenFolder_Click" IsEnabled="False"/>
                    <Button x:Name="btnCsv" Content="XUẤT BÁO CÁO CSV" Click="BtnCsv_Click" IsEnabled="False"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="3. Thống kê" Foreground="#FFD166" Margin="0,0,0,8">
            <WrapPanel>
                <Label x:Name="statSrt" Content="Đoạn SRT: -" Margin="4,0,16,0"/>
                <Label x:Name="statImages" Content="Ảnh tìm thấy: -" Margin="4,0,16,0"/>
                <Label x:Name="statMissing" Content="Ảnh thiếu: -" Margin="4,0,16,0" Foreground="#FF9E9E"/>
                <Label x:Name="statExtra" Content="Ảnh dư: -" Margin="4,0,16,0" Foreground="#FFD166"/>
                <Label x:Name="statDuration" Content="Tổng thời lượng: -" Margin="4,0,16,0"/>
                <Label x:Name="statInvalid" Content="Đoạn SRT lỗi: -" Margin="4,0,16,0" Foreground="#FF9E9E"/>
            </WrapPanel>
        </GroupBox>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="4. Xem trước timeline" Foreground="#FFD166" Margin="0,0,6,0">
                <DataGrid x:Name="gridPreview" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#1E1E1E" Foreground="#F0F0F0"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          RowBackground="#1E1E1E" AlternatingRowBackground="#242424">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Binding="{Binding Order}" Width="50"/>
                        <DataGridTextColumn Header="Tên ảnh" Binding="{Binding ImageName}" Width="*"/>
                        <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartText}" Width="110"/>
                        <DataGridTextColumn Header="Kết thúc" Binding="{Binding EndText}" Width="110"/>
                        <DataGridTextColumn Header="Thời lượng" Binding="{Binding DurationText}" Width="90"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Nhật ký" Foreground="#FFD166">
                <TextBox x:Name="txtLog" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
            </GroupBox>
        </Grid>

        <ProgressBar Grid.Row="5" x:Name="progressBar" Height="18" Minimum="0" Maximum="100" Margin="0,8,0,4"/>
        <TextBlock Grid.Row="6" x:Name="txtStatus" Text="Sẵn sàng." Foreground="#9E9E9E"/>
    </Grid>
</Window>
